{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=auth-db;Database=auth_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "blog-platform-api-auth-service-nov-2025-by-pavel",
    "Issuer": "SimpleCloudDrive",
    "Audience": "SimpleCloudDrive",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "InstanceName": "AuthService",
    "CacheTimeoutMinutes": 30
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      },
      "gRPC": {
        "Url": "http://0.0.0.0:6001",
        "Protocols": "Http2"
      }
    }
  }
}