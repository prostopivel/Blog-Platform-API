{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=blog-db;Database=auth_db;Username=postgres;Password=postgres",
    "CommandTimeout": 10,
    "ConnectionTimeout": 5
  },
  "Redis": {
    "ConnectionString": "redis:6379",
    "InstanceName": "BlogService",
    "CacheTimeoutMinutes": 30
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      },
      "gRPC": {
        "Url": "http://0.0.0.0:6002",
        "Protocols": "Http2"
      }
    }
  }
}